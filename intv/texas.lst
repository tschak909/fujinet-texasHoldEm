                                	SRCFILE "fujinet.bas",368
542E   02B8 0070                	MVII #112,R0
5430   0240 013D                	MVO R0,var_MB_DEV
                                	;[369]     mb_cmd = FUJICMD_CLOSE_APPKEY
                                	SRCFILE "fujinet.bas",369
5432   02B8 00DB                	MVII #219,R0
5434   0240 013C                	MVO R0,var_MB_CMD
                                	;[370]     mb_nparam = 0
                                	SRCFILE "fujinet.bas",370
5436   01C0                     	CLRR R0
5437   0240 013F                	MVO R0,var_MB_NPARAM
                                	;[371]     #fn_txlen = 0
                                	SRCFILE "fujinet.bas",371
5439   0240 030E                	MVO R0,var_&FN_TXLEN
                                	;[372]     GOSUB fn_transact
