  ;== 6                             ENDR

6C2D   000C                     	INCR R4
6C2E   033C 6C41                @@7:    SUBI #_keypad_table+1,R4
6C30   0244 0111                	MVO R4,_cnt2_key

6C32   0281 0110                @@5:    MVI _cnt2_p1,R1
6C34   0241 010F                	MVO R1,_cnt2_p0
