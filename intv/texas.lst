6CCD   0268                     	MVO@ R0,R5
  ;== 8                             ENDR
6CCE   01C0                     	CLRR R0		; Erase collision bits (R5 = $18)
6CCF   0268                     	MVO@ R0,R5
6CD0   0268                     	MVO@ R0,R5
6CD1   0268                     	MVO@ R0,R5
6CD2   0268                     	MVO@ R0,R5
6CD3   0268                     	MVO@ R0,R5
6CD4   0268                     	MVO@ R0,R5
6CD5   0268                     	MVO@ R0,R5
