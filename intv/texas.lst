6BFE   0340 0110                	CMP _cnt2_p1,R0
6C00   020C 0030                	BNE @@5
6C02   0080                     	TSTR R0		; Accelerates common case of key not pressed
6C03   02BC 6C4D                	MVII #_keypad_table+13,R4
6C05   0204 0027                	BEQ @@7
6C07   02BC 6C40                	MVII #_keypad_table,R4
                                    REPEAT 6
