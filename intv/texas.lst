5575   02B8 0002                	MVII #2,R0
5577   0240 015A                	MVO R0,var_SND_POST
5579   0004 0154 0109           	CALL label_PLAY_TONE
                                	;[60]     #snd_val = 260 : snd_gate = 4 : snd_post = 2 : GOSUB play_tone
                                	SRCFILE "sound.bas",60
557C   02B8 0104                	MVII #260,R0
557E   0240 0317                	MVO R0,var_&SND_VAL
5580   02B8 0004                	MVII #4,R0
5582   0240 0158                	MVO R0,var_SND_GATE
5584   02B8 0002                	MVII #2,R0
5586   0240 015A                	MVO R0,var_SND_POST
5588   0004 0154 0109           	CALL label_PLAY_TONE
                                	;[61] END
                                	SRCFILE "sound.bas",61
558B   02B7                     	RETURN
