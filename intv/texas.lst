54C0   0240 0317                	MVO R0,var_&SND_VAL
54C2   02B8 0005                	MVII #5,R0
54C4   0240 014B                	MVO R0,var_SND_GATE
54C6   02B8 0008                	MVII #8,R0
54C8   0240 014D                	MVO R0,var_SND_POST
54CA   0004 0154 0087           	CALL label_PLAY_TONE
                                	;[53]     #snd_val = 329 : snd_gate = 5 : snd_post = 0 : GOSUB play_tone
                                	SRCFILE "sound.bas",53
54CD   02B8 0149                	MVII #329,R0
54CF   0240 0317                	MVO R0,var_&SND_VAL
54D1   02B8 0005                	MVII #5,R0
54D3   0240 014B                	MVO R0,var_SND_GATE
54D5   01C0                     	CLRR R0
54D6   0240 014D                	MVO R0,var_SND_POST
54D8   0004 0154 0087           	CALL label_PLAY_TONE
                                	;[54]     #snd_val = 224 : snd_gate = 5 : snd_post = 0 : GOSUB play_tone
                                	SRCFILE "sound.bas",54
54DB   02B8 00E0                	MVII #224,R0
54DD   0240 0317                	MVO R0,var_&SND_VAL
54DF   02B8 0005                	MVII #5,R0
54E1   0240 014B                	MVO R0,var_SND_GATE
54E3   01C0                     	CLRR R0
54E4   0240 014D                	MVO R0,var_SND_POST
54E6   0004 0154 0087           	CALL label_PLAY_TONE
                                	;[55] END
                                	SRCFILE "sound.bas",55
54E9   02B7                     	RETURN
                                	ENDP
