6192   02B9 FFFF                	MVII #65535,R1
6194   0205 0001                	BLT T185
6196   0009                     	INCR R1
0x6197                          T185:
6197   0019                     	COMR R1
6198   0188                     	ANDR R1,R0
6199   0019                     	COMR R1
619A   01C8                     	XORR R1,R0
