0x6C4C                          _set_isr:	PROC
6C4C   02A8                     	MVI@ R5,R0
6C4D   0240 0100                	MVO R0,ISRVEC
6C4F   0040                     	SWAP R0
6C50   0240 0101                	MVO R0,ISRVEC+1
