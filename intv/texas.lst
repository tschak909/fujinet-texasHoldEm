5603   0240 0317                	MVO R0,var_&SND_VAL
5605   02B8 0002                	MVII #2,R0
5607   0240 014B                	MVO R0,var_SND_GATE
5609   0240 014D                	MVO R0,var_SND_POST
560B   0004 0154 0087           	CALL label_PLAY_TONE
                                	;[116] END
                                	SRCFILE "sound.bas",116
560E   02B7                     	RETURN
                                	ENDP
