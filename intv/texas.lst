6C9D   01ED                     	CLRR R5		; X-coordinates
                                    REPEAT 8
6C9E   02A0                     	MVI@ R4,R0
6C9F   0268                     	MVO@ R0,R5
6CA0   02A0                     	MVI@ R4,R0
6CA1   0268                     	MVO@ R0,R5
6CA2   02A0                     	MVI@ R4,R0
6CA3   0268                     	MVO@ R0,R5
  ;== 1                             ENDR
