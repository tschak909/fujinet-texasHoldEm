                                	SRCFILE "fujinet.bas",248
                                	; NET_CLOSE
0x529E                          label_NET_CLOSE:	PROC
529E   0275                     	BEGIN
                                	;[249]     mb_dev = NET_DEVICEID
                                	SRCFILE "fujinet.bas",249
529F   02B8 0071                	MVII #113,R0
52A1   0240 0130                	MVO R0,var_MB_DEV
                                	;[250]     mb_cmd = NETCMD_CLOSE
                                	SRCFILE "fujinet.bas",250
52A3   02B8 0043                	MVII #67,R0
52A5   0240 012F                	MVO R0,var_MB_CMD
                                	;[251]     mb_nparam = 0
                                	SRCFILE "fujinet.bas",251
52A7   01C0                     	CLRR R0
52A8   0240 0132                	MVO R0,var_MB_NPARAM
                                	;[252]     #fn_txlen = 0
                                	SRCFILE "fujinet.bas",252
52AA   0240 030E                	MVO R0,var_&FN_TXLEN
                                	;[253]     GOSUB fn_transact
