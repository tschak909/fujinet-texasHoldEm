6D43   0284 033C                	MVI _gram_bitmap,R4
6D45   00A4                     	TSTR R4
6D46   0204 001E                	BEQ @@vi1
6D48   0281 0105                	MVI _gram_target,R1
6D4A   004D                     	SLL R1,2
6D4B   0049                     	SLL R1,1
6D4C   02F9 3800                	ADDI #$3800,R1
6D4E   008D                     	MOVR R1,R5
6D4F   0280 0106                	MVI _gram_total,R0
0x6D51                          @@vi3:
6D51   02A1                     	MVI@    R4,     R1
6D52   0269                     	MVO@    R1,     R5
6D53   0041                     	SWAP    R1
6D54   0269                     	MVO@    R1,     R5
6D55   02A1                     	MVI@    R4,     R1
6D56   0269                     	MVO@    R1,     R5
6D57   0041                     	SWAP    R1
6D58   0269                     	MVO@    R1,     R5
6D59   02A1                     	MVI@    R4,     R1
6D5A   0269                     	MVO@    R1,     R5
6D5B   0041                     	SWAP    R1
6D5C   0269                     	MVO@    R1,     R5
6D5D   02A1                     	MVI@    R4,     R1
6D5E   0269                     	MVO@    R1,     R5
6D5F   0041                     	SWAP    R1
6D60   0269                     	MVO@    R1,     R5
6D61   0010                     	DECR R0
6D62   022C 0012                	BNE @@vi3
6D64   0240 033C                	MVO R0,_gram_bitmap
0x6D66                          @@vi1:
6D66   0284 033D                	MVI _gram2_bitmap,R4
6D68   00A4                     	TSTR R4
6D69   0204 001E                	BEQ @@vii1
6D6B   0281 0107                	MVI _gram2_target,R1
6D6D   004D                     	SLL R1,2
6D6E   0049                     	SLL R1,1
6D6F   02F9 3800                	ADDI #$3800,R1
6D71   008D                     	MOVR R1,R5
6D72   0280 0108                	MVI _gram2_total,R0
0x6D74                          @@vii3:
6D74   02A1                     	MVI@    R4,     R1
6D75   0269                     	MVO@    R1,     R5
6D76   0041                     	SWAP    R1
6D77   0269                     	MVO@    R1,     R5
6D78   02A1                     	MVI@    R4,     R1
6D79   0269                     	MVO@    R1,     R5
6D7A   0041                     	SWAP    R1
6D7B   0269                     	MVO@    R1,     R5
