6D3C   0268                     	MVO@ R0,R5
6D3D   0268                     	MVO@ R0,R5
6D3E   0268                     	MVO@ R0,R5
6D3F   0268                     	MVO@ R0,R5
6D40   0268                     	MVO@ R0,R5
6D41   0268                     	MVO@ R0,R5
6D42   0268                     	MVO@ R0,R5

                                    IF DEFINED intybasic_music
                                     	MVI _ntsc,R0
                                	RRC R0,1	 ; PAL?
                                	BNC @@vo97      ; Yes, always emit sound
                                	MVI _music_frame,R0
                                	INCR R0
                                	CMPI #6,R0
                                	BNE @@vo14
                                	CLRR R0
                                @@vo14:	MVO R0,_music_frame
                                	BEQ @@vo15
                                @@vo97:	CALL _emit_sound
                                    IF DEFINED intybasic_music_ecs
                                	CALL _emit_sound_ecs
                                    ENDI
                                @@vo15:
                                    ENDI

                                	;
