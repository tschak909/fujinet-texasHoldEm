                                	;[60]     #snd_val = 260 : snd_gate = 4 : snd_post = 2 : GOSUB play_tone
                                	SRCFILE "sound.bas",60
54FA   02B8 0104                	MVII #260,R0
54FC   0240 0317                	MVO R0,var_&SND_VAL
54FE   02B8 0004                	MVII #4,R0
5500   0240 014B                	MVO R0,var_SND_GATE
5502   02B8 0002                	MVII #2,R0
