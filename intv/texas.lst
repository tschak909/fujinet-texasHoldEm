5764   0275                     	BEGIN
                                	;[167]     df_stop = 0
                                	SRCFILE "texas.bas",167
5765   01C0                     	CLRR R0
5766   0240 0121                	MVO R0,var_DF_STOP
                                	;[168]     FOR df_i = 0 TO df_len - 1
                                	SRCFILE "texas.bas",168
5768   0240 011E                	MVO R0,var_DF_I
0x576A                          T58:
                                	;[169]         df_c = PEEK(#df_src + df_i) AND 255
                                	SRCFILE "texas.bas",169
576A   0281 030B                	MVI var_&DF_SRC,R1
576C   02C1 011E                	ADD var_DF_I,R1
576E   0288                     	MVI@ R1,R0
576F   0240 011D                	MVO R0,var_DF_C
                                	;[170]         IF df_c = 0 THEN df_stop = 1
                                	SRCFILE "texas.bas",170
5771   0280 011D                	MVI var_DF_C,R0
5773   0080                     	TSTR R0
5774   020C 0004                	BNE T59
5776   02B8 0001                	MVII #1,R0
5778   0240 0121                	MVO R0,var_DF_STOP
0x577A                          T59:
                                	;[171]         IF df_stop THEN
                                	SRCFILE "texas.bas",171
577A   0280 0121                	MVI var_DF_STOP,R0
577C   0080                     	TSTR R0
577D   0204 0006                	BEQ T60
                                	;[172]             df_c = 32
                                	SRCFILE "texas.bas",172
577F   02B8 0020                	MVII #32,R0
5781   0240 011D                	MVO R0,var_DF_C
                                	;[173]         ELSEIF df_c >= 97 AND df_c <= 122 THEN
                                	SRCFILE "texas.bas",173
5783   0200 001B                	B T61
0x5785                          T60:
5785   0280 011D                	MVI var_DF_C,R0
5787   0378 0061                	CMPI #97,R0
5789   02B8 FFFF                	MVII #65535,R0
578B   020D 0001                	BGE T63
578D   0008                     	INCR R0
0x578E                          T63:
578E   0281 011D                	MVI var_DF_C,R1
5790   0379 007A                	CMPI #122,R1
5792   02B9 FFFF                	MVII #65535,R1
5794   0206 0001                	BLE T64
5796   0009                     	INCR R1
0x5797                          T64:
5797   0188                     	ANDR R1,R0
